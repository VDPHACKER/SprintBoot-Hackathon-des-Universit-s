# Copier vers .env. Les secrets sont générés par scripts/init-stack.sh dans data/secrets/.
# Aucune valeur réelle ici : uniquement des noms et des valeurs fictives.
SERVER_NAME=chat.localhost
CHAT_PORT=8080

# Comptes de démonstration fictifs (identifiants publics dans deploy/keycloak/demo-users.json).
# Mettre à false pour une installation réelle, AVANT le premier démarrage.
DEMO_ACCOUNTS=true
