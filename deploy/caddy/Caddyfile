{
	auto_https off
	admin off
}

# Éléments communs aux portails de messagerie: API Matrix et client web. La console d'administration (admin.html) n'y est jamais servie.
(messagerie) {
	# Jamais exposés : API d'administration de Synapse, fédération, page de la console d'administration.
	@blocked path /_synapse/admin/* /_matrix/federation/* /_matrix/key/* /admin.html
	handle @blocked {
		respond "Not found" 404
	}

	@matrix path /_matrix/* /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008
	}

	# Client web (application monopage). Politique CSP stricte: la session vit dans le navigateur,
	# aucun script ni style externe n'est autorisé; 'wasm-unsafe-eval' est requis par le chiffrement (WebAssembly).
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
			X-Frame-Options DENY
			Cache-Control "no-cache"
		}
		root * /srv/client
		try_files {path} /index.html
		file_server
	}
}

# Messagerie (8080): garde l'API d'administration pour l'outil en ligne de commande (scripts/admin.mjs) et les tests.
:8080 {
	handle_path /admin-api/* {
		reverse_proxy admin:3000
	}
	import messagerie
}

# Deux portails de démonstration (une session par origine): même application, SANS accès à l'API d'administration.
:8000, :8001 {
	@adminapi path /admin-api/*
	handle @adminapi {
		respond "Not found" 404
	}
	import messagerie
}

# Console d'administration: application distincte de la messagerie (propre origine, propre connexion Keycloak).
:8002 {
	handle_path /admin-api/* {
		reverse_proxy admin:3000
	}
	handle {
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' http://auth.localhost:8081; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Frame-Options DENY
			Cache-Control "no-cache"
		}
		root * /srv/client
		# Seules la page d'accueil, /assets et l'icône existent: tout autre chemin répond 404 (pas de repli vers la page).
		@page path /
		rewrite @page /admin.html
		@allowed path /admin.html /assets/* /favicon.svg
		handle @allowed {
			file_server
		}
		handle {
			respond "Not found" 404
		}
	}
}

# Identité (Keycloak). La console d'administration et l'API d'administration ne sont pas exposées.
:8081 {
	@private path /admin/* /realms/master /realms/master/* /metrics* /health*
	handle @private {
		respond "Not found" 404
	}

	handle {
		reverse_proxy keycloak:8080
	}
}