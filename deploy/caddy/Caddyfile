{
	auto_https off
	admin off
}

# Messagerie: API Matrix, API d'administration de la messagerie.
:8080 {
	# Jamais exposés : API d'administration de Synapse et fédération.
	@blocked path /_synapse/admin/* /_matrix/federation/* /_matrix/key/*
	handle @blocked {
		respond "Not found" 404
	}

	@matrix path /_matrix/* /_synapse/client/*
	handle @matrix {
		reverse_proxy synapse:8008
	}

	handle_path /admin-api/* {
		reverse_proxy admin:3000
	}

	handle {
		respond "Not found" 404
	}
}

# Identité (Keycloak). La console d'administration et l'API d'administration ne sont pas exposées.
:8081 {
	@private path /admin/* /realms/master/* /metrics* /health*
	handle @private {
		respond "Not found" 404
	}

	handle {
		reverse_proxy keycloak:8080
	}
}