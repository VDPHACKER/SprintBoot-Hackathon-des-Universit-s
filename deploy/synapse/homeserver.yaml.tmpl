# Rendu par scripts/init-stack.sh (string.Template). Ne pas modifier data/synapse/homeserver.yaml à la main.
server_name: "${SERVER_NAME}"
public_baseurl: "http://localhost:${CHAT_PORT}/"
pid_file: /data/homeserver.pid
report_stats: false

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    bind_addresses: ["0.0.0.0"]
    resources:
      - names: [client, media]
        compress: false

database:
  name: psycopg2
  args:
    user: synapse
    password: "${POSTGRES_PASSWORD}"
    database: synapse
    host: postgres
    cp_min: 5
    cp_max: 10

log_config: "/data/log.config"
media_store_path: /data/media_store
signing_key_path: "/data/${SERVER_NAME}.signing.key"

registration_shared_secret: "${REGISTRATION_SHARED_SECRET}"
macaroon_secret_key: "${MACAROON_SECRET_KEY}"
form_secret: "${FORM_SECRET}"

# Enrôlement fermé : seuls les comptes créés par l'administration existent.
enable_registration: false
allow_guest_access: false
password_config:
  enabled: false

# Identité: connexion uniquement par Keycloak (mot de passe + TOTP). Le jeton de connexion revient au client web.
sso:
  client_whitelist:
    - "http://localhost:${CHAT_PORT}/"
oidc_providers:
  - idp_id: keycloak
    idp_name: "Identité de l'administration"
    # Démo locale en HTTP: Synapse exige un émetteur HTTPS. En production (TLS devant Keycloak), RETIRER cette ligne.
    skip_verification: true
    issuer: "http://auth.localhost:8081/realms/bf"
    client_id: synapse
    client_secret: "${SYNAPSE_OIDC_SECRET}"
    scopes: ["openid", "profile"]
    allow_existing_users: true
    # Seuls les comptes enrôlés par le service d'administration (attribut « enrolled ») obtiennent un compte de messagerie.
    attribute_requirements:
      - attribute: enrolled
        value: "true"
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.display_name }}"

# Le serveur refuse tout contenu en clair (voir modules/no_plaintext.py).
modules:
  - module: no_plaintext.NoPlaintext
    config: {}

# Tous les salons sont chiffrés de bout en bout dès leur création.
encryption_enabled_by_default_for_room_type: all

# Limite de connexions par adresse: la connexion par mot de passe est désactivée (identité par Keycloak, qui a sa propre
# protection contre les essais répétés), donc la limite par défaut ne protège rien et bloquait les connexions rapprochées
# (démonstration, plusieurs agents derrière une même adresse de l'administration).
rc_login:
  address: { per_second: 1, burst_count: 30 }
  account: { per_second: 1, burst_count: 30 }
  failed_attempts: { per_second: 1, burst_count: 30 }

# Minimisation des métadonnées.
presence:
  enabled: false
url_preview_enabled: false
user_ips_max_age: 7d

# Aucune fédération, aucun appel sortant vers d'autres serveurs.
federation_domain_whitelist: []
trusted_key_servers: []
suppress_key_server_warning: true
allow_public_rooms_over_federation: false

max_upload_size: 50M
user_directory:
  enabled: true
  search_all_users: false